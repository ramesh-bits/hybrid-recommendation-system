# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/

# ── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ── Environment variables ────────────────────────────────────────────────────
# Keep .env.example (template), ignore actual secrets
.env

# ── Data – downloaded & generated, not source-controlled ────────────────────
data/raw/           # MovieLens zip + extracted files (~30 MB) — run `make data`
data/processed/     # Pickle files (numpy-version-sensitive) — run `make data`
data/models/        # Trained model artefacts — run POST /train

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── IDE / editors ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Docker ───────────────────────────────────────────────────────────────────
